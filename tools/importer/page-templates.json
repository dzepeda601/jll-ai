          "name": "Explore a brighter way",
          "selector": [
            "div.bg-container div.accordion-carousel",
            "div.accordion-carousel"
          ],
          "style": "split",
          "blocks": [
            "tabs-stacked",
            "cards-eyebrow"
          ],
          "defaultContent": [
            "div.accordion-carousel h2",
            "div.accordion-carousel h2 + p"
